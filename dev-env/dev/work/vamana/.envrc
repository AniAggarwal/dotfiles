# Work secrets, loaded by direnv from KeePassXC (Machine Secrets) for everything under this tree.
# Values live only in KeePassXC; see ~/bin/sec and ~/.config/direnv/lib/secrets.sh.
use secret ANTHROPIC_API_KEY HF_TOKEN WANDB_API_KEY HYPERSTACK_API_KEY \
    VAMANA_API_KEY UV_INDEX_VAMANA_USERNAME \
    GARUDA_CHARTS_TOKEN GARUDA_DATA_APP_KEY GARUDA_DATA_KEY_ID \
    TIGRIS_STORAGE_ACCESS_KEY_ID TIGRIS_STORAGE_SECRET_ACCESS_KEY TIGRIS_STORAGE_ENDPOINT \
    PERSONAL_TIGRIS_STORAGE_ACCESS_KEY_ID PERSONAL_TIGRIS_STORAGE_SECRET_ACCESS_KEY PERSONAL_TIGRIS_STORAGE_ENDPOINT \
    VIDEO_DATASETS_APP_KEY VIDEO_DATASETS_KEY_ID
