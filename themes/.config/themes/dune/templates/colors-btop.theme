# Dune dynamic theme for btop — generated by matugen, do not edit by hand
# Main background/foreground
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Title and highlight
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"

# Selection
theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"

# Inactive / misc
theme[inact_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"

# Box outlines
theme[cpu_box]="{{colors.outline_variant.default.hex}}"
theme[mem_box]="{{colors.outline_variant.default.hex}}"
theme[net_box]="{{colors.outline_variant.default.hex}}"
theme[proc_box]="{{colors.outline_variant.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Temperature gradient (surface -> primary -> error for hot)
theme[temp_start]="{{colors.surface_bright.default.hex}}"
theme[temp_mid]="{{colors.primary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

# CPU gradient (surface -> primary)
theme[cpu_start]="{{colors.surface_bright.default.hex}}"
theme[cpu_mid]="{{colors.secondary.default.hex}}"
theme[cpu_end]="{{colors.primary.default.hex}}"

# Memory gradients (surface -> primary)
theme[free_start]="{{colors.surface_bright.default.hex}}"
theme[free_mid]="{{colors.secondary.default.hex}}"
theme[free_end]="{{colors.primary.default.hex}}"

theme[cached_start]="{{colors.surface_bright.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.primary.default.hex}}"

theme[available_start]="{{colors.surface_bright.default.hex}}"
theme[available_mid]="{{colors.secondary.default.hex}}"
theme[available_end]="{{colors.primary.default.hex}}"

theme[used_start]="{{colors.surface_bright.default.hex}}"
theme[used_mid]="{{colors.secondary.default.hex}}"
theme[used_end]="{{colors.primary.default.hex}}"

# Network gradients (surface -> primary)
theme[download_start]="{{colors.surface_bright.default.hex}}"
theme[download_mid]="{{colors.secondary.default.hex}}"
theme[download_end]="{{colors.primary.default.hex}}"

theme[upload_start]="{{colors.surface_bright.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.primary.default.hex}}"

# Process gradient (surface -> primary)
theme[process_start]="{{colors.surface_bright.default.hex}}"
theme[process_mid]="{{colors.secondary.default.hex}}"
theme[process_end]="{{colors.primary.default.hex}}"
