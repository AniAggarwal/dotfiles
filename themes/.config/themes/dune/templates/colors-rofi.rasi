/* Dune theme — generated by matugen from {{image}} */
/* Variable names must match the existing rofi colors/dune.rasi */

* {
    background:     {{colors.surface_container.default.hex}};
    background-alt: {{colors.surface_container_high.default.hex}};
    foreground:     {{colors.on_surface.default.hex}};
    selected:       {{ colors.primary.default.hex | to_color | lighten: -25.0 | saturate: -25.0, "hsl" | format: "hex" }};
    active:         {{colors.primary.default.hex}};
    urgent:         {{colors.error.default.hex}};
}
