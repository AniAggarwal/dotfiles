#!/usr/bin/bash
# Copies every variable in ~/.secrets into the Secret Service (KeePassXC) as an item with the
# attribute env=<NAME>, so it can be read with `secret-tool lookup env <NAME>` (see `sec` and the
# direnv `use_secret` helper). Values are piped straight into secret-tool and never printed.
#
#   secrets-import --dry-run   list the names that would be imported
#   secrets-import             import, then verify each one reads back identically
#
# Items land in the group KeePassXC exposes to the Secret Service. Existing items with the same
# name are replaced. ~/.secrets itself is left alone.
set -euo pipefail
file=${SECRETS_FILE:-$HOME/.secrets}
mapfile -t names < <(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "$file" | sort -u)
(( ${#names[@]} )) || { echo "no variables found in $file" >&2; exit 1; }

if [[ ${1:-} == --dry-run ]]; then
    printf '%s\n' "${names[@]}"
    exit 0
fi

# The file is already sourced by every interactive shell; do the same in this process only.
set -a
# shellcheck disable=SC1090
. "$file"
set +a

# KeePassXC answers ReadAlias("default") but doesn't export the alias object that secret-tool
# stores into by default, so resolve the collection path and pass it explicitly.
collection=$(busctl --user call org.freedesktop.secrets /org/freedesktop/secrets \
    org.freedesktop.Secret.Service ReadAlias s default | sed -nE 's/^o "(.+)"$/\1/p')
if [[ -z $collection || $collection == / ]]; then
    echo "no default Secret Service collection: is KeePassXC unlocked with a database exposed?" >&2
    exit 1
fi

failed=0
for name in "${names[@]}"; do
    value=${!name-}
    if [[ -z $value ]]; then
        echo "skip  $name (empty)"
        continue
    fi
    if ! printf '%s' "$value" | secret-tool store --collection="$collection" --label="env: $name" env "$name"; then
        echo "FAIL  $name (store)"; failed=1; continue
    fi
    if [[ "$(secret-tool lookup env "$name")" == "$value" ]]; then
        echo "ok    $name"
    else
        echo "FAIL  $name (read-back differs)"; failed=1
    fi
done
exit $failed
